# 資料庫設定 (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stock_hunter
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# FinMind API Token (前往 https://finmind.github.io/ 註冊免費 Token)
FINMIND_API_TOKEN_1=your_token_here
# FINMIND_API_TOKEN_2=your_second_token_if_any

# 併發與頻率設定 (建議每顆 Token 配 3~5 個 Worker)
MAX_WORKERS=5
API_MAX_CALLS_PER_HOUR=300

# 錯誤處理與自動重試
API_WAIT_TIME_402=600        # 當遇到 402 Rate Limit (頻率限制) 時的等待冷卻秒數
API_RETRY_DELAY=5            # 一般網路錯誤或 503 錯誤時的重試間隔秒數
HTTP_TIMEOUT=30               # API 請求的最大等待時間 (秒)

# 資料庫連線池設定 (進階)
DB_POOL_MIN=1
DB_POOL_MAX=20

# Web 伺服器設定
WEB_HOST=0.0.0.0
WEB_PORT=8000

# 日誌設定 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 匯出目錄
EXPORT_DIR=csv_exports

# 收集器預設開始日期 (格式: YYYY-MM-DD)
DEFAULT_START_DATE=2020-01-01
